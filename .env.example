# Copy to `.env`. Dev works with defaults; prod requires every value below.

# --- common ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- postgres (prod: use a URL-safe password, e.g. `openssl rand -hex 24`) ---
POSTGRES_USER=moozzzer
POSTGRES_PASSWORD=moozzzer
POSTGRES_DB=moozzzer

# --- auth ---
# Access-token signing key, >= 32 chars (`openssl rand -base64 48`). Required in prod;
# empty in dev = random per process (access tokens die on reload, refresh tokens survive).
JWT_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# Per IP+login and per IP, attempts per minute on /auth/login and /auth/register.
# AUTH_RATE_LIMIT_PER_MINUTE=5
# AUTH_RATE_LIMIT_IP_PER_MINUTE=20

# --- providers ---
# Comma-separated provider keys (see backend/app/providers/registry.py).
# PROVIDERS_METADATA=youtube_music
# PROVIDERS_AUDIO=youtube_music,soundcloud
# PROVIDERS_TIMEOUT_SECONDS=10
# PROVIDERS_CACHE_TTL_SECONDS=300
# PROVIDERS_STREAM_CACHE_TTL_SECONDS=1800

# --- prod only ---
# GitHub owner (lowercase) of ghcr.io/<owner>/moozzzer-{api,worker,web}
GHCR_OWNER=
TAG=latest
DOMAIN=moozzzer.ekroll.app
ACME_EMAIL=

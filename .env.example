# Copy to `.env`. Dev works with defaults; prod requires every value below.

# --- common ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- postgres (prod: use a URL-safe password, e.g. `openssl rand -hex 24`) ---
POSTGRES_USER=moozzzer
POSTGRES_PASSWORD=moozzzer
POSTGRES_DB=moozzzer

# --- prod only ---
# GitHub owner (lowercase) of ghcr.io/<owner>/moozzzer-{api,worker,web}
GHCR_OWNER=
TAG=latest
DOMAIN=moozzzer.ekroll.app
ACME_EMAIL=
